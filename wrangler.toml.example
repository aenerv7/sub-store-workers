name = "sub-store-backend"
main = "dist/worker.js"
compatibility_date = "2026-09-04"
compatibility_flags = ["nodejs_compat"]
workers_dev = false
keep_vars = true

[secrets]
required = ["SUB_STORE_FRONTEND_BACKEND_PATH"]

# KV Namespace bindings
# Bind this to the existing namespace used by the current Worker.
[[kv_namespaces]]
binding = "SUB_STORE_DATA"
id = "你的KV命名空间ID"

# 定时同步（每天北京时间 05:00 执行）
[triggers]
crons = ["0 21 * * *"]

[vars]
# SUB_STORE_FRONTEND_BACKEND_PATH = "/你的密码"
# SUB_STORE_PUSH_SERVICE = "https://api.day.app/你的BarkKey/[推送标题]/[推送内容]"
SCRIPT_ENGINE = "quickjs"
SUB_STORE_BACKEND_CUSTOM_NAME = "Workers"
SUB_STORE_BACKEND_CUSTOM_ICON = "https://cdn.jsdelivr.net/gh/Yu9191/sub-store-workers@main/png/cloudflare.png"
