{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sub-store-workers-test",
  "main": "dist/worker.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SCRIPT_ENGINE": "disabled",
    "SUB_STORE_BACKEND_CUSTOM_ICON": "https://example.com/icon.png",
    "SUB_STORE_BACKEND_CUSTOM_NAME": "Workers Test",
    "SUB_STORE_CORS_ALLOWED_ORIGINS": "https://sub-store.vercel.app",
    "SUB_STORE_FRONTEND_BACKEND_PATH": "/test-secret",
    "SUB_STORE_PUSH_SERVICE": "https://push.example.com/private-token/[推送标题]/[推送内容]"
  },
  "kv_namespaces": [
    {
      "binding": "SUB_STORE_DATA",
      "id": "00000000000000000000000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SUB_STORE_COORDINATOR",
        "class_name": "SubStoreCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SubStoreCoordinator"]
    }
  ]
}
