{
  "name": "sub-store-workers",
  "version": "1.1.0",
  "description": "Sub-Store on Cloudflare Workers",
  "private": true,
  "scripts": {
    "build": "node esbuild.js",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "rotate-secret": "powershell -ExecutionPolicy Bypass -File scripts/rotate-secret.ps1 -WorkerName sub-store-backend",
    "rotate-secret:sh": "bash scripts/rotate-secret.sh --name sub-store-backend"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "age-encryption": "^0.3.0",
    "buffer": "^6.0.3",
    "dns-packet": "^5.6.1",
    "ip-address": "^9.0.5",
    "js-base64": "^3.7.2",
    "json5": "^2.2.3",
    "jsrsasign": "^11.1.0",
    "lodash": "^4.17.21",
    "ms": "^2.1.3",
    "nanoid": "^3.3.3",
    "peggy": "^2.0.1",
    "quickjs-emscripten": "^0.32.0",
    "semver": "^7.6.3",
    "static-js-yaml": "^1.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.19.8",
    "wrangler": "^4.84.1"
  }
}
