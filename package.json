{
  "name": "sub-store-workers",
  "version": "1.1.0",
  "description": "Sub-Store on Cloudflare Workers",
  "private": true,
  "scripts": {
    "build": "node esbuild.js",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run test:worker",
    "test:worker": "npm run build && vitest run",
    "check:deploy": "npm run build && wrangler deploy --dry-run --config wrangler.test.jsonc",
    "rotate-secret": "powershell -ExecutionPolicy Bypass -File scripts/rotate-secret.ps1 -WorkerName sub-store-backend",
    "rotate-secret:sh": "bash scripts/rotate-secret.sh --name sub-store-backend"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "age-encryption": "^0.3.0",
    "buffer": "^6.0.3",
    "dns-packet": "^5.6.1",
    "ip-address": "^10.7.0",
    "js-base64": "^3.7.2",
    "json5": "^2.2.3",
    "jsrsasign": "^11.1.0",
    "lodash": "^4.17.21",
    "ms": "^2.1.3",
    "nanoid": "^3.3.18",
    "peggy": "^2.0.1",
    "quickjs-emscripten": "^0.32.0",
    "semver": "^7.6.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
